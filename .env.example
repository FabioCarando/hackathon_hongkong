# Copy to .env and fill in. Never commit .env.

# --- AWS credentials -------------------------------------------------------
# Option A: a named profile from ~/.aws/config (SSO or access keys)
AWS_PROFILE=
# Option B: paste the temporary credentials the organisers give you
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# --- LLM -----------------------------------------------------------------
# bedrock = real calls; fake = simulated Claude: no network, no cost (UI work, offline testing)
LLM_PROVIDER=bedrock
# fake only: 0 = instant, 1 = roughly real Claude speed
FAKE_LATENCY=1
# mantle = Bedrock Messages-API endpoint (preferred); runtime = classic bedrock-runtime
BEDROCK_CLIENT=mantle
# Run `uv run python scripts/check_env.py` to see which IDs your account can use
LLM_MODEL=anthropic.claude-opus-5
LLM_MODEL_FAST=anthropic.claude-haiku-4-5
LLM_MAX_TOKENS=16000

# on = read-through disk cache: identical requests are answered from disk (free, instant, works
# with no wifi). Point LLM_CACHE_DIR at a committed folder to share a demo cache with the team.
LLM_CACHE=off
LLM_CACHE_DIR=.llm_cache
