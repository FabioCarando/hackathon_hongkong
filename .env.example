# Copy to .env and fill in. Never commit .env.

# --- LLM -----------------------------------------------------------------
# openrouter = real calls (default); bedrock = Amazon Bedrock (see below);
# fake = simulated model: no network, no cost (UI work, offline testing)
LLM_PROVIDER=openrouter
# fake only: 0 = instant, 1 = roughly real model speed
FAKE_LATENCY=1

# --- OpenRouter (default) --------------------------------------------------
# Create a key at https://openrouter.ai/settings/keys (add credits, or use ":free" model slugs)
OPENROUTER_API_KEY=
# Optional: app name shown in OpenRouter's usage/activity pages (sent as X-Title)
OPENROUTER_APP_NAME=trace
# Any model slug from https://openrouter.ai/models works; changing these is all it takes to switch
# model, e.g. qwen/qwen3-235b-a22b-2507  meta-llama/llama-4-maverick  deepseek/deepseek-chat-v3.1
# Run `uv run python scripts/check_env.py` to check they exist and handle tools/structured output.
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Multimodal model for OCR of scanned PDFs (gpt-oss is text-only), e.g. google/gemini-2.5-flash
LLM_MODEL_VISION=google/gemini-2.5-flash
# Output cap per call. OpenRouter checks your balance against it (402 if too high for what's left)
# and Bedrock reserves it from your token quota, so keep it modest; models with a lower limit are
# clamped automatically.
LLM_MAX_TOKENS=4096

# on = read-through disk cache: identical requests are answered from disk (free, instant, works
# with no wifi). Point LLM_CACHE_DIR at a committed folder to share a demo cache with the team.
LLM_CACHE=off
LLM_CACHE_DIR=.llm_cache

# --- Alternative: Amazon Bedrock ---------------------------------------------
# From HK, Claude/OpenAI are geo-blocked and new accounts get ~0 daily token quota.
# To use it: LLM_PROVIDER=bedrock and Bedrock model / inference-profile IDs, e.g.
#   LLM_MODEL=us.amazon.nova-pro-v1:0   LLM_MODEL_FAST=us.amazon.nova-lite-v1:0
# Credentials, option A: a named profile from ~/.aws/config (SSO or access keys)
AWS_PROFILE=
# Option B: paste the temporary credentials the organisers give you
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# --- Trace -------------------------------------------------------------------
# The app works on a runtime copy of workspace/ (reset from the sidebar); workspace/ stays pristine
TRACE_WORKSPACE=runtime/workspace
TRACE_SEED_WORKSPACE=workspace
# Default commit author / decision maker (the sidebar selector overrides it)
TRACE_USER=Anna Chan
