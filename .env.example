# Copy to .env and fill in. Never commit .env.

# --- AWS credentials -------------------------------------------------------
# Option A: a named profile from ~/.aws/config (SSO or access keys)
AWS_PROFILE=
# Option B: paste the temporary credentials the organisers give you
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# --- LLM -----------------------------------------------------------------
# bedrock = real calls; fake = simulated model: no network, no cost (UI work, offline testing)
LLM_PROVIDER=bedrock
# fake only: 0 = instant, 1 = roughly real model speed
FAKE_LATENCY=1
# Any Bedrock text model or inference-profile ID; changing these is all it takes to switch model.
# Run `uv run python scripts/check_env.py` to see which IDs your account can use, e.g.
#   us.amazon.nova-premier-v1:0  us.meta.llama4-maverick-17b-instruct-v1:0  openai.gpt-oss-120b-1:0
LLM_MODEL=us.amazon.nova-pro-v1:0
LLM_MODEL_FAST=us.amazon.nova-lite-v1:0
# Output cap per call. Bedrock reserves this much of your token quota on every request, so keep it
# modest; models with a lower limit are clamped automatically.
LLM_MAX_TOKENS=4096

# on = read-through disk cache: identical requests are answered from disk (free, instant, works
# with no wifi). Point LLM_CACHE_DIR at a committed folder to share a demo cache with the team.
LLM_CACHE=off
LLM_CACHE_DIR=.llm_cache
